# Kunci rahasia Flask untuk menandatangani session cookie. WAJIB diganti di production.
# Buat nilai acak, misalnya: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-nilai-acak-yang-panjang

# development = debug aktif, cookie Secure nonaktif (untuk lokal tanpa HTTPS).
# production  = debug nonaktif, cookie Secure aktif.
FLASK_ENV=development

# Penyimpanan session server-side: "filesystem" untuk lokal, "redis" untuk production.
SESSION_TYPE=filesystem

# Wajib diisi jika SESSION_TYPE=redis, contoh: redis://default:password@host:6379/0
# REDIS_URL=

# Masa hidup session dalam menit. Setelah lewat, pengguna harus login dan
# memasukkan API key kembali.
SESSION_LIFETIME_MINUTES=120

# Model OpenAI yang dipakai untuk seluruh analisis.
OPENAI_MODEL=gpt-5.6

# Batas waktu request ke OpenAI (detik).
OPENAI_TIMEOUT_SECONDS=300

# Batas maksimum token keluaran per request analisis. Keluaran yang mencapai
# batas dan terpotong akan ditolak agar JSON parsial tidak ditampilkan.
OPENAI_MAX_OUTPUT_TOKENS=16000

# Bagian artikel yang panjang dipecah per kelompok paragraf mendekati jumlah
# karakter ini. Nomor paragraf dan kalimat asli tetap dipertahankan.
SECTION_CHUNK_CHARS=20000

# Email kontak untuk API Crossref/OpenAlex (opsional, disarankan).
SCHOLARLY_API_EMAIL=email_anda@example.com

# CATATAN: Aplikasi TIDAK membutuhkan OPENAI_API_KEY milik pemilik aplikasi.
# Setiap pengguna memasukkan API key miliknya sendiri setelah login, dan key
# tersebut hanya disimpan sementara di server-side session.
