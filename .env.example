# Kunci rahasia Flask untuk menandatangani session cookie. WAJIB dan harus tetap
# sama antar-restart/redeploy. Jangan commit nilai sebenarnya.
# Buat nilai acak, misalnya: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=ganti-dengan-nilai-acak-yang-panjang

# development = cookie Secure nonaktif (untuk lokal tanpa HTTPS).
# production  = debug nonaktif, cookie Secure aktif.
FLASK_ENV=development

# Aktifkan debugger lokal hanya bila diperlukan. Jangan aktifkan di production
# karena traceback interaktif dapat menampilkan data request.
FLASK_DEBUG=0

# Database akun. Kosongkan untuk memakai SQLite hanya saat development lokal.
# Production WAJIB PostgreSQL melalui DATABASE_URL.
# Isi DATABASE_URL hanya di .env lokal yang tidak dilacak atau environment host.
# DATABASE_URL=
# Alternatif lama postgres:// otomatis dinormalisasi menjadi postgresql://.

# Kunci Fernet untuk mengenkripsi API key pengguna. WAJIB di production.
# Jangan menaruh nilainya di file yang dilacak Git.
# API_KEY_ENCRYPTION_KEY=

# Penyimpanan session server-side: "cachelib" hanya untuk lokal.
# Production memakai "sqlalchemy" agar session tersimpan di PostgreSQL.
SESSION_TYPE=cachelib

# Masa hidup session dalam menit. Setelah lewat, pengguna harus login kembali;
# API key terenkripsi tetap tersimpan pada akun.
SESSION_LIFETIME_MINUTES=120

# Model OpenAI yang dipakai untuk seluruh analisis.
OPENAI_MODEL=gpt-5.6

# Batas waktu request ke OpenAI (detik).
OPENAI_TIMEOUT_SECONDS=300

# Batas maksimum token keluaran per request analisis. Keluaran yang mencapai
# batas dan terpotong akan ditolak agar JSON parsial tidak ditampilkan.
OPENAI_MAX_OUTPUT_TOKENS=16000

# Bagian artikel yang panjang dipecah per kelompok paragraf mendekati jumlah
# karakter ini. Nomor paragraf dan kalimat asli tetap dipertahankan.
SECTION_CHUNK_CHARS=20000

# Email kontak untuk API Crossref/OpenAlex (opsional, disarankan).
SCHOLARLY_API_EMAIL=email_anda@example.com

# DATABASE_PATH hanya untuk SQLite development/test lokal.
# DATABASE_PATH=instance/app.db
